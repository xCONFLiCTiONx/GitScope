{
  "name": "GitScope",
  "version": "1.0.0",
  "description": "A local-first desktop wrapper for Git repository management.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.gitscope.desktop",
    "productName": "GitScope",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}"
    },
    "npmRebuild": false
  },
  "keywords": [
    "git",
    "windows",
    "electron"
  ],
  "author": "xCONFLiCTiONx",
  "license": "NOT PERMITTED WITHOUT PERMISSION",
  "dependencies": {
    "chokidar": "^3.5.3",
    "fs-extra": "^11.1.1",
    "marked": "^5.1.2",
    "monaco-editor": "^0.43.0",
    "node-pty": "^1.0.0",
    "simple-git": "^3.19.0",
    "xterm": "^5.2.1",
    "xterm-addon-fit": "^0.7.0"
  },
  "devDependencies": {
    "electron": "^25.3.0",
    "electron-builder": "^26.15.3"
  }
}
